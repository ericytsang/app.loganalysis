-- create tables

CREATE TABLE ProjectEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- user-defined name for the configuration.
  -- it could be blank, in which case the app will display a generate name
  name TEXT NOT NULL,
  -- the time when the configuration was created
  update_sequence INTEGER NOT NULL,
  -- the current logcat filter that is inputted into the text field
  logcat_filter TEXT NOT NULL,
  -- whether this configuration when the app was closed
  is_active INTEGER NOT NULL
);

CREATE TABLE LogFileEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  config_id INTEGER NOT NULL,
  file_path TEXT NOT NULL,
  -- the order in which the log files are displayed and concatenated in the UI
  order_index INTEGER NOT NULL,
  FOREIGN KEY (config_id) REFERENCES ProjectEntity(id) ON DELETE CASCADE,
  UNIQUE (config_id, file_path),
  CHECK (order_index >= 0)
);

-- filter used to show or hide log lines that match the filter string
CREATE TABLE FilterEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  config_id INTEGER NOT NULL,

  -- whether the filter is used to include or exclude matching log lines
  is_exclude_filter INTEGER NOT NULL,

  -- the order in which the filter is displayed in the UI
  order_index INTEGER NOT NULL,

  -- the filter string that is used to match log lines
  filter_string TEXT NOT NULL,

  -- whether the filter string is case sensitive or not
  is_case_sensitive INTEGER NOT NULL,

  -- 'string_literal', 'regex', or 'logcat_filter'
  filter_interpretation_mode TEXT NOT NULL,

  -- whether the filter is active and being used to filter log lines or not
  is_active INTEGER NOT NULL,

  FOREIGN KEY (config_id) REFERENCES ProjectEntity(id) ON DELETE CASCADE,
  UNIQUE (order_index, config_id, is_exclude_filter)
);

CREATE TABLE SettingsEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- the theme of the app: 'light' or 'dark'
  theme TEXT NOT NULL,
  -- delimiters to look for in the logs that separate words
  color_coding_delimiters TEXT NOT NULL,
  -- whether to wrap the text in the log viewer: 1 for true, 0 for false
  should_wrap_text INTEGER NOT NULL
);

-- insert default values into the database

INSERT INTO SettingsEntity
VALUES (1, 'light', ':,.;!@#$%^&* ()_+=-`~|?<>\\/[]{}\"', 0);

-- everything below are SQLDelight queries

-- region general

lastInsertId:
SELECT last_insert_rowid();

-- endregion

-- region settings

selectSettings:
SELECT * FROM SettingsEntity
WHERE id = 1;

updateTheme:
UPDATE SettingsEntity
SET theme = ?
WHERE id = 1;

updateColorCodingDelimiters:
UPDATE SettingsEntity
SET color_coding_delimiters = ?
WHERE id = 1;

updateShouldWrapText:
UPDATE SettingsEntity
SET should_wrap_text = ?
WHERE id = 1;

-- endregion

-- region projects

insertProject:
INSERT INTO ProjectEntity (name, update_sequence, logcat_filter, is_active)
VALUES (?, ?, ?, ?);

updateProject:
UPDATE ProjectEntity
SET name = ?,
    update_sequence = ?,
    logcat_filter = ?,
    is_active = ?
WHERE id = ?;

selectAllProjects:
SELECT * FROM ProjectEntity
ORDER BY update_sequence DESC;

selectNextNActiveProjects:
SELECT * FROM ProjectEntity
WHERE is_active = 1 AND update_sequence < ?
ORDER BY update_sequence DESC
LIMIT ?;

selectNProjectsUpdatedAfter:
SELECT * FROM ProjectEntity
WHERE update_sequence > ?
ORDER BY update_sequence ASC
LIMIT ?;

selectNProjectsUpdatedBefore:
SELECT * FROM ProjectEntity
WHERE update_sequence < ?
ORDER BY update_sequence DESC
LIMIT ?;

selectLastUpdatedProject:
SELECT * FROM ProjectEntity
ORDER BY update_sequence DESC
LIMIT 1;

deleteProject:
DELETE FROM ProjectEntity
WHERE id = ?;

-- endregion

-- region log files

insertLogFile:
INSERT INTO LogFileEntity (config_id, file_path, order_index)
VALUES (?, ?, ?);

selectLogFilesForConfig:
SELECT * FROM LogFileEntity
WHERE config_id = ?
ORDER BY order_index;

-- endregion

-- region filters

insertFilter:
INSERT INTO FilterEntity (config_id, is_exclude_filter, order_index, filter_string, is_case_sensitive, filter_interpretation_mode, is_active)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllFiltersForConfig:
SELECT * FROM FilterEntity
WHERE config_id = ? AND is_exclude_filter = ?;

selectActiveFiltersForConfig:
SELECT * FROM FilterEntity
WHERE config_id = ? AND is_active = 1;

selectFiltersForConfigDesc:
SELECT * FROM FilterEntity
WHERE config_id = ? AND is_exclude_filter = ? AND order_index < ?
ORDER BY order_index DESC
LIMIT ?;

selectFiltersForConfigAsc:
SELECT * FROM FilterEntity
WHERE config_id = ? AND is_exclude_filter = ? AND order_index > ?
ORDER BY order_index ASC
LIMIT ?;

updateOrderIndex:
UPDATE FilterEntity
SET order_index = ?
WHERE id = ?;

updateFilterString:
UPDATE FilterEntity
SET filter_string = ?
WHERE id = ?;

updateIsCaseSensitive:
UPDATE FilterEntity
SET is_case_sensitive = ?
WHERE id = ?;

updateFilterInterpretationMode:
UPDATE FilterEntity
SET filter_interpretation_mode = ?
WHERE id = ?;

updateIsActive:
UPDATE FilterEntity
SET is_active = ?
WHERE id = ?;

deleteFilter:
DELETE FROM FilterEntity
WHERE id = ?;

-- endregion