-- create tables

CREATE TABLE ConfigurationEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- user-defined name for the configuration.
  -- it could be blank, in which case the app will display a generate name
  name TEXT NOT NULL,
  -- the time when the configuration was created
  update_sequence INTEGER NOT NULL,
  -- the current logcat filter that is inputted into the text field
  logcat_filter TEXT NOT NULL
);

CREATE TABLE LogFileEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  config_id INTEGER NOT NULL,
  file_path TEXT NOT NULL,
  -- the order in which the log files are displayed and concatenated in the UI
  order_index INTEGER NOT NULL,
  FOREIGN KEY (config_id) REFERENCES ConfigurationEntity(id) ON DELETE CASCADE,
  UNIQUE (config_id, file_path),
  CHECK (order_index >= 0)
);

-- "exclude" filters are used to exclude log lines that match the filter string
CREATE TABLE ExcludeFilterEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  filter_string TEXT NOT NULL,
  is_case_sensitive INTEGER NOT NULL,
  is_regex INTEGER NOT NULL,
  is_active INTEGER NOT NULL,
  order_index INTEGER NOT NULL,
  config_id INTEGER,
  FOREIGN KEY (config_id) REFERENCES ConfigurationEntity(id) ON DELETE CASCADE,
  UNIQUE (filter_string, config_id)
);

-- "include" filter used to include log lines that match the filter string
CREATE TABLE IncludeFilterEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  filter_string TEXT NOT NULL,
  is_case_sensitive INTEGER NOT NULL,
  is_regex INTEGER NOT NULL,
  is_active INTEGER NOT NULL,
  order_index INTEGER NOT NULL,
  config_id INTEGER,
  FOREIGN KEY (config_id) REFERENCES ConfigurationEntity(id) ON DELETE CASCADE,
  UNIQUE (filter_string, config_id)
);

-- logcat filter used to include log lines that match the filter string
CREATE TABLE LogCatFilterEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  filter_string TEXT NOT NULL,
  config_id INTEGER,
  order_index INTEGER NOT NULL,
  is_active INTEGER NOT NULL,
  FOREIGN KEY (config_id) REFERENCES ConfigurationEntity(id) ON DELETE CASCADE,
  UNIQUE (filter_string, config_id)
);

CREATE TABLE SettingsEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- the theme of the app: 'light' or 'dark'
  theme TEXT NOT NULL,
  -- delimiters to look for in the logs that separate words
  color_coding_delimiters TEXT NOT NULL,
  -- whether to wrap the text in the log viewer: 1 for true, 0 for false
  should_wrap_text INTEGER NOT NULL
);

-- insert default values into the database

INSERT INTO SettingsEntity
VALUES (1, 'light', ':,.;!@#$%^&* ()_+=-`~|?<>\\/[]{}\"', 0);

-- everything below are SQLDelight queries

-- region general

lastInsertId:
SELECT last_insert_rowid();

-- endregion

-- region settings

selectSettings:
SELECT * FROM SettingsEntity
WHERE id = 1;

updateTheme:
UPDATE SettingsEntity
SET theme = ?
WHERE id = 1;

updateColorCodingDelimiters:
UPDATE SettingsEntity
SET color_coding_delimiters = ?
WHERE id = 1;

updateShouldWrapText:
UPDATE SettingsEntity
SET should_wrap_text = ?
WHERE id = 1;

-- endregion

-- region configurations

insertConfiguration:
INSERT INTO ConfigurationEntity (name, update_sequence, logcat_filter)
VALUES (?, ?, ?);

updateConfiguration:
UPDATE ConfigurationEntity
SET name = ?,
    update_sequence = ?,
    logcat_filter = ?
WHERE id = ?;

selectAllConfigurations:
SELECT * FROM ConfigurationEntity
ORDER BY update_sequence DESC;

selectNConfigurationsUpdatedAfter:
SELECT * FROM ConfigurationEntity
WHERE update_sequence >= ?
ORDER BY update_sequence ASC
LIMIT ?;

selectNConfigurationsUpdatedBefore:
SELECT * FROM ConfigurationEntity
WHERE update_sequence <= ?
ORDER BY update_sequence DESC
LIMIT ?;

selectLastUpdatedConfiguration:
SELECT * FROM ConfigurationEntity
ORDER BY update_sequence DESC
LIMIT 1;

deleteConfiguration:
DELETE FROM ConfigurationEntity
WHERE id = ?;

-- endregion

-- region log files

insertLogFile:
INSERT INTO LogFileEntity (config_id, file_path, order_index)
VALUES (?, ?, ?);

selectLogFilesForConfig:
SELECT * FROM LogFileEntity
WHERE config_id = ?
ORDER BY order_index;

-- endregion

-- region filters

-- endregion