-- create tables

CREATE TABLE Configurations (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  -- user-defined name for the configuration.
  -- it could be blank, in which case the app will display a generate name
  name TEXT NOT NULL,
  -- the time when the configuration was created
  created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE TABLE LogFiles (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  config_id INTEGER NOT NULL,
  file_path TEXT NOT NULL,
  -- the order in which the log files are displayed and concatenated in the UI
  order_index INTEGER NOT NULL,
  FOREIGN KEY (config_id) REFERENCES Configurations(id) ON DELETE CASCADE,
  UNIQUE (config_id, file_path),
  CHECK (order_index >= 0)
);

CREATE TABLE Filters (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  filter_string TEXT NOT NULL,
  config_id INTEGER,
  created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
  FOREIGN KEY (config_id) REFERENCES Configurations(id) ON DELETE SET NULL,
  UNIQUE (filter_string, config_id)
);

CREATE TABLE Settings (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  theme TEXT NOT NULL DEFAULT 'light'
);

-- create indexes for performance

CREATE INDEX idx_logfiles_config_id ON LogFiles(config_id);
CREATE INDEX idx_filters_config_id ON Filters(config_id);

-- insert default values into the database

INSERT INTO Settings
VALUES (1, 'light');

-- everything below are SQLDelight queries

-- region general

lastInsertId:
SELECT last_insert_rowid();

-- endregion

-- region settings

selectSettings:
SELECT * FROM Settings
WHERE id = 1;

insertSettings:
INSERT INTO Settings
VALUES (1, 'light');

updateSettings:
UPDATE Settings
SET theme = ?
WHERE id = 1;

-- endregion

-- region configurations

insertConfiguration:
INSERT INTO Configurations (name)
VALUES (?);

selectAllConfigurations:
SELECT * FROM Configurations
ORDER BY created_at DESC;

-- endregion

-- region log files

insertLogFile:
INSERT INTO LogFiles (config_id, file_path, order_index)
VALUES (?, ?, ?);

-- endregion

-- region filters

selectLogFilesForConfig:
SELECT * FROM LogFiles
WHERE config_id = ?
ORDER BY order_index;

insertFilter:
INSERT INTO Filters (filter_string, config_id)
VALUES (?, ?);

selectFilters:
SELECT * FROM Filters
WHERE config_id IS NULL OR config_id = ?
ORDER BY created_at DESC;

-- endregion